# SolREM Environment Configuration
# Copy this file to .env and fill in the values

# =============================================================================
# SOLANA CONFIGURATION
# =============================================================================

# Network: 'devnet' | 'testnet' | 'mainnet'
VITE_SOLANA_NETWORK=devnet

# RPC Endpoint (optional - uses defaults if not set)
# VITE_SOLANA_RPC_URL=https://api.devnet.solana.com

# Program ID (Anchor deployed address)
VITE_PROGRAM_ID=SoLrEmPrEdIcTiOnMaRkEtS1111111111111111111

# Token Mint Address (if using SPL tokens)
VITE_TOKEN_MINT=SoLrEm1111111111111111111111111111111111

# =============================================================================
# SUPABASE CONFIGURATION
# =============================================================================

# Project URL and anon key (get from Supabase Dashboard > Settings > API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# =============================================================================
# GEMINI AI CONFIGURATION (Optional)
# =============================================================================

# Gemini API Key for AI insights (optional - falls back to mock data)
VITE_GEMINI_API_KEY=your-gemini-api-key

# =============================================================================
# WALLET CONFIGURATION
# =============================================================================

# Minimum balance for transactions (in SOL)
VITE_MIN_BALANCE_SOL=0.1

# Max transaction fee estimate (in SOL)
VITE_MAX_FEE_SOL=0.01
